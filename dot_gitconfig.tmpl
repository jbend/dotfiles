# Managed by chezmoi — edit with: chezmoi edit ~/.gitconfig
# Read after ~/.config/git/config, so values here win on conflicts.
{{- $opSshSign := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $opSshSign = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" }}
{{- else }}
{{-   $opSshSign = "/opt/1Password/op-ssh-sign" }}
{{- end }}

# Default identity is personal; repos under ~/Code/wcc/ switch to WCC (see includeIf below).
[user]
	name = Jeff Bendixsen
	email = jbendixsen@gmail.com

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[alias]
	lg = log --pretty='%C(red)%h%Creset%C(yellow)%d%Creset %s %C(cyan)(%ar)%Creset'
	new = lg main..HEAD
	missing = lg HEAD..main
	glt = log --oneline --decorate --graph --all
	glta = log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --all

[init]
	defaultBranch = main

[merge]
	conflictStyle = zdiff3
{{- if lookPath "delta" }}

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
{{- end }}
{{- if stat $opSshSign }}

# Commit/tag signing with the GitHub SSH key stored in 1Password (Families → Private).
# The key is public; allowed_signers lets `git log --show-signature` verify locally.
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO4oRHxkHxHap+dQXqoul9aTPhZyJWgndHh+qpjPz7aE
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ $opSshSign }}
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgSign = true
{{- end }}

# Keep last so it overrides [user] above.
[includeIf "gitdir:~/Code/wcc/"]
	path = ~/.config/git/wcc.gitconfig
