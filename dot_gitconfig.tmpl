# Managed by chezmoi — edit with: chezmoi edit ~/.gitconfig
# Read after ~/.config/git/config, so values here win on conflicts.

[user]
	name = Jeff Bendixsen
	email = jbendixsen@gmail.com

# Commit signing and SSH will be configured via 1Password later.

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[alias]
	lg = log --pretty='%C(red)%h%Creset%C(yellow)%d%Creset %s %C(cyan)(%ar)%Creset'
	new = lg main..HEAD
	missing = lg HEAD..main
	glt = log --oneline --decorate --graph --all
	glta = log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --all

[init]
	defaultBranch = main

[merge]
	conflictStyle = zdiff3
{{- if lookPath "delta" }}

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
{{- end }}
